rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dongntph52925@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isAdvisor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'advisor';
    }

    function isVerified() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kycStatus == 'verified';
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); 
      allow create: if isOwner(userId) && incoming().role != 'admin'; // Cannot self-promote to admin
      allow update: if (isOwner(userId) && (
        // Regular user can only update these
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'country', 'company', 'phoneNumber', 'twoFactorEnabled', 'kycStatus', 'kycData', 'updatedAt'])
      )) || isAdmin();
    }

    // --- Companies ---
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if (isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin();
    }

    // --- Deals ---
    match /deals/{dealId} {
      allow read: if (resource.data.status == 'published') || 
                     (isSignedIn() && resource.data.sellerId == request.auth.uid) || 
                     isAdmin() || isAdvisor();
      allow create: if isSignedIn() && 
                       (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' || isAdmin()) && 
                       incoming().sellerId == request.auth.uid;
      allow update: if (isSignedIn() && existing().sellerId == request.auth.uid) || isAdmin();
    }

    // --- General Chats ---
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (request.auth.uid in resource.data.participants || request.auth.uid in incoming().participants || isAdmin() || isAdvisor());
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }
    
    // --- Sub-collections ---
    match /deals/{dealId}/offers/{offerId} {
      allow read, write: if isSignedIn();
    }
    match /deals/{dealId}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }
    match /deals/{dealId}/meetings/{meetingId} {
      allow read, write: if isSignedIn();
    }
    match /deals/{dealId}/ndas/{ndaId} {
      allow read, write: if isSignedIn();
    }
  }
}
